# Copia este archivo a .env y completa los valores. El .env NO se sube a git.
# Después de cambiar el .env hay que reiniciar `npm start`.

# Supabase: Settings -> API (solo la clave "anon" / publishable; NUNCA la service_role)
REACT_APP_SUPABASE_URL=https://TU-PROYECTO.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

